rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.email == "osherper@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isMainAdmin()
        || (
          signedIn()
          && hasUserDoc(request.auth.uid)
          && userDoc(request.auth.uid).data.role == "admin"
        );
    }

    function isApprovedSelf(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasUserDoc(uid)
        && userDoc(uid).data.status == "approved";
    }

    function validOwnImmutableFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    function noApprovalFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approvedAt",
        "approvedBy",
        "approvalEmailStatus",
        "approvalEmailSentAt",
        "approvalEmailSentBy",
        "approvalEmailPreparedAt",
        "approvalEmailPreparedBy"
      ]);
    }

    function autoBetaActive() {
      return request.time < timestamp.date(2026, 5, 16);
    }

    function validAutoBetaFields() {
      return request.resource.data.status == "approved"
        && request.resource.data.approvedBy == "auto-beta"
        && request.resource.data.approvalMode == "auto-beta-14-days";
    }

    function validUserCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "photoURL",
        "provider",
        "role",
        "status",
        "approvedAt",
        "approvedBy",
        "approvalMode",
        "createdAt",
        "lastLoginAt",
        "updatedAt"
      ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserCreateKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == "osherper@gmail.com"
            && request.resource.data.role == "admin"
            && request.resource.data.status == "approved")
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && request.resource.data.role == "student"
            && request.resource.data.status == "pending")
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && autoBetaActive()
            && request.resource.data.role == "student"
            && validAutoBetaFields())
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && autoBetaActive()
          && resource.data.status == "pending"
          && resource.data.role == "student"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "photoURL",
            "provider",
            "lastLoginAt",
            "updatedAt",
            "status",
            "approvedAt",
            "approvedBy",
            "approvalMode"
          ])
          && validAutoBetaFields()
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && validOwnImmutableFields()
          && noApprovalFieldChanges()
        );

      allow delete: if false;

      match /progress/{lessonId} {
        allow read: if isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.lessonId == lessonId;
        allow delete: if false;
      }

      match /examAttempts/{attemptId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.attemptId == attemptId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /siteVersions/{versionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /feedbackReports/{reportId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.priority == "normal"
        && request.resource.data.adminNotes == ""
        && request.resource.data.keys().hasOnly([
          "reportId",
          "type",
          "title",
          "description",
          "pageUrl",
          "userId",
          "userName",
          "userEmail",
          "status",
          "priority",
          "adminNotes",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /activeSessions/{uid} {
      allow read: if isAdmin();
      allow create, update: if isApprovedSelf(uid)
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "lastSeenAt",
          "currentPath",
          "userAgent",
          "isMobile"
        ]);
      allow delete: if isAdmin();
    }

    match /gameProgress/{uid} {
      allow read: if isAdmin() || isApprovedSelf(uid);
      allow create, update: if isApprovedSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "totalXp",
          "completedStages",
          "currentUnit",
          "currentStage",
          "mistakes",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
