rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSignedIn() {
      return signedIn();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.email == "osherper@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isMainAdmin()
        || (
          signedIn()
          && hasUserDoc(request.auth.uid)
          && userDoc(request.auth.uid).data.role == "admin"
        );
    }

    function isApprovedSelf(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasUserDoc(uid)
        && userDoc(uid).data.status == "approved";
    }

    function isApprovedRequester() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && userDoc(request.auth.uid).data.status == "approved";
    }

    function isApprovedAdminToolUser() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && (
          userDoc(request.auth.uid).data.role == "admin"
          || userDoc(request.auth.uid).data.admin == true
        )
        && userDoc(request.auth.uid).data.approved == true;
    }

    function isApproved() {
      return isAdmin() || isApprovedRequester();
    }

    function validOwnImmutableFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    function validOwnUserUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName",
        "photoURL",
        "provider",
        "lastLoginAt",
        "updatedAt",
        "profileSurvey",
        "profileSurveyCompletedAt",
        "profileSurveySkippedAt",
        "lastSeenVersionAt",
        "lastSeenVersionUpdatedAt"
      ]);
    }

    function noApprovalFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approved",
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "updatedBy",
        "approvalEmailStatus",
        "approvalEmailSentAt",
        "approvalEmailSentBy",
        "approvalEmailPreparedAt",
        "approvalEmailPreparedBy"
      ]);
    }

    function validStagingApprovalToolUpdate(uid) {
      return isApprovedAdminToolUser()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "approved",
          "approvalStatus",
          "approvedAt",
          "approvedBy",
          "updatedAt",
          "updatedBy"
        ])
        && (
          (
            request.resource.data.approved == true
            && request.resource.data.approvalStatus == "approved"
            && request.resource.data.approvedBy == request.auth.uid
          )
          ||
          (
            request.resource.data.approved == false
            && request.resource.data.approvalStatus == "not-approved"
            && request.resource.data.updatedBy == request.auth.uid
          )
        );
    }

    function validStagingAdminBootstrap(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email == "osherper@gmail.com"
        && resource.data.email == "osherper@gmail.com"
        && (
          resource.data.role == "admin"
          || resource.data.admin == true
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "approved",
          "approvalStatus",
          "approvedAt",
          "updatedAt",
          "bootstrapApproved"
        ])
        && request.resource.data.approved == true
        && request.resource.data.approvalStatus == "approved"
        && request.resource.data.bootstrapApproved == true;
    }

    function noStagingApprovalToolFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approved",
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "updatedBy"
      ]);
    }

    function autoBetaActive() {
      return request.time < timestamp.date(2026, 5, 16);
    }

    function validAutoBetaFields() {
      return request.resource.data.status == "approved"
        && request.resource.data.approvedBy == "auto-beta"
        && request.resource.data.approvalMode == "auto-beta-14-days";
    }

    function validUserCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "photoURL",
        "provider",
        "role",
        "status",
        "approvedAt",
        "approvedBy",
        "approvalMode",
        "createdAt",
        "lastLoginAt",
        "updatedAt"
      ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserCreateKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == "osherper@gmail.com"
            && request.resource.data.role == "admin"
            && request.resource.data.status == "approved")
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && request.resource.data.role == "student"
            && request.resource.data.status == "pending")
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && autoBetaActive()
            && request.resource.data.role == "student"
            && validAutoBetaFields())
        );

      allow update: if validStagingAdminBootstrap(uid)
        || validStagingApprovalToolUpdate(uid)
        || (
          isAdmin()
          && noStagingApprovalToolFieldChanges()
        )
        || (
          isOwner(uid)
          && autoBetaActive()
          && resource.data.status == "pending"
          && resource.data.role == "student"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "photoURL",
            "provider",
            "lastLoginAt",
            "updatedAt",
            "status",
            "approvedAt",
            "approvedBy",
            "approvalMode"
          ])
          && validAutoBetaFields()
        )
        || (
          isOwner(uid)
          && validOwnImmutableFields()
          && validOwnUserUpdateKeys()
          && noApprovalFieldChanges()
        );

      allow delete: if false;

      match /progress/{lessonId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.lessonId == lessonId;
        allow delete: if false;
      }

      match /examAttempts/{attemptId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.attemptId == attemptId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /stats/{statsId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && statsId == "summary"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "userId",
            "totalQuestionsAnswered",
            "totalCorrect",
            "totalWrong",
            "lessonsCompleted",
            "examsCompleted",
            "gameXP",
            "updatedAt"
          ]);
        allow delete: if false;
      }
    }

    match /siteVersions/{versionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /examQuestionPools/{lessonId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isApproved();
        allow create, update, delete: if isAdmin();
      }
    }

    match /protectedQuestionPreviews/{questionId} {
      allow read: if (isAdmin()
          || (
            signedIn()
            && hasUserDoc(request.auth.uid)
            && (
              userDoc(request.auth.uid).data.status == "approved"
              || userDoc(request.auth.uid).data.approved == true
            )
          ))
        && !resource.data.keys().hasAny([
          "correctAnswer",
          "correctAnswerId",
          "correctIndex",
          "answerKey",
          "solution",
          "isCorrect",
          "explanation",
          "pointsByAnswer",
          "scoring"
        ]);
      allow create, update, delete: if false;
    }

    match /telegramCourseSchedules/{courseId} {
      allow read, create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /userProgress/{uid} {
      allow read: if isAdmin() || isApprovedSelf(uid);
      allow create, update: if isApprovedSelf(uid)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;

      match /{document=**} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /feedbackReports/{reportId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.priority == "normal"
        && request.resource.data.adminNotes == ""
        && request.resource.data.keys().hasOnly([
          "reportId",
          "type",
          "title",
          "description",
          "pageUrl",
          "userId",
          "userName",
          "userEmail",
          "status",
          "priority",
          "adminNotes",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /questionReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isApprovedRequester()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "reportId",
          "questionId",
          "lessonId",
          "issueType",
          "freeText",
          "questionText",
          "correctAnswer",
          "selectedAnswer",
          "userId",
          "userEmail",
          "createdAt"
        ]);
      allow update, delete: if false;
    }

    match /questionRatings/{ratingId} {
      allow read: if isAdmin() || (isApprovedRequester() && resource.data.userId == request.auth.uid);
      allow create, update: if isApprovedRequester()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "ratingId",
          "questionId",
          "lessonId",
          "rating",
          "userId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if false;
    }

    match /questionFeedback/{questionId} {
      allow read: if isAdmin() || isApprovedRequester();
      allow create, update: if isApprovedRequester()
        && request.resource.data.questionId == questionId
        && request.resource.data.keys().hasOnly([
          "questionId",
          "lessonId",
          "lastIssueType",
          "lastReportedAt",
          "lastLowRating",
          "status",
          "updatedAt"
        ])
        && request.resource.data.status == "needs-review";
      allow delete: if isAdmin();
    }

    match /questionIssues/{questionId} {
      allow read: if isAdmin() || isApprovedRequester();
      allow create, update: if isApprovedRequester()
        && request.resource.data.questionId == questionId
        && request.resource.data.keys().hasOnly([
          "questionId",
          "lessonId",
          "reportsCount",
          "ratingCount",
          "ratingSum",
          "avgRating",
          "lastReportedAt",
          "status",
          "priority",
          "updatedAt",
          "fixedAt"
        ])
        && request.resource.data.status in ["open", "in-progress"]
        && request.resource.data.priority in ["high", "medium", "low"];
      allow update, delete: if isAdmin();
    }

    match /activeSessions/{uid} {
      allow read: if isAdmin();
      allow create, update: if isApprovedSelf(uid)
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "lastSeenAt",
          "currentPath",
          "userAgent",
          "isMobile"
        ]);
      allow delete: if isAdmin();
    }

    match /gameProgress/{uid} {
      allow read: if isAdmin() || isApprovedSelf(uid);
      allow create, update: if isApprovedSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "totalXp",
          "completedStages",
          "currentUnit",
          "currentStage",
          "difficulty",
          "lastDifficultyRecommendation",
          "mistakes",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
