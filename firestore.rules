rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.email == "osherper@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isMainAdmin()
        || (
          signedIn()
          && hasUserDoc(request.auth.uid)
          && userDoc(request.auth.uid).data.role == "admin"
        );
    }

    function isApprovedSelf(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasUserDoc(uid)
        && userDoc(uid).data.status == "approved";
    }

    function validOwnImmutableFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    function noApprovalFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approvedAt",
        "approvedBy",
        "approvalEmailStatus",
        "approvalEmailSentAt",
        "approvalEmailSentBy",
        "approvalEmailPreparedAt",
        "approvalEmailPreparedBy"
      ]);
    }

    function validUserCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "photoURL",
        "provider",
        "role",
        "status",
        "createdAt",
        "lastLoginAt"
      ]);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserCreateKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == "osherper@gmail.com"
            && request.resource.data.role == "admin"
            && request.resource.data.status == "approved")
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && request.resource.data.role == "student"
            && request.resource.data.status == "pending")
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && validOwnImmutableFields()
          && noApprovalFieldChanges()
        );

      allow delete: if false;

      match /progress/{lessonId} {
        allow read: if isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.lessonId == lessonId;
        allow delete: if false;
      }

      match /examAttempts/{attemptId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.attemptId == attemptId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /siteVersions/{versionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
