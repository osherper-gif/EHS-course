rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSignedIn() {
      return signedIn();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMainAdmin() {
      return signedIn() && request.auth.token.email == "osherper@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isMainAdmin()
        || (
          signedIn()
          && hasUserDoc(request.auth.uid)
          && (
            userDoc(request.auth.uid).data.get("role", "") == "admin"
            || userDoc(request.auth.uid).data.get("admin", false) == true
          )
          && userDoc(request.auth.uid).data.get("blocked", false) != true
          && userDoc(request.auth.uid).data.get("status", "active") != "blocked"
        );
    }

    function isApprovedSelf(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasUserDoc(uid)
        && userDoc(uid).data.get("blocked", false) != true
        && userDoc(uid).data.get("status", "active") != "blocked";
    }

    function isApprovedRequester() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && userDoc(request.auth.uid).data.get("blocked", false) != true
        && userDoc(request.auth.uid).data.get("status", "active") != "blocked";
    }

    function isApprovedAdminToolUser() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && (
          userDoc(request.auth.uid).data.get("role", "") == "admin"
          || userDoc(request.auth.uid).data.get("admin", false) == true
        )
        && userDoc(request.auth.uid).data.get("blocked", false) != true
        && userDoc(request.auth.uid).data.get("status", "active") != "blocked";
    }

    function isApproved() {
      return isAdmin() || isApprovedRequester();
    }

    function validOwnImmutableFields() {
      return request.resource.data.get("uid", "") == resource.data.get("uid", "")
        && request.resource.data.get("email", "") == resource.data.get("email", "")
        && request.resource.data.get("role", "") == resource.data.get("role", "")
        && request.resource.data.get("admin", false) == resource.data.get("admin", false)
        && request.resource.data.get("status", "active") == resource.data.get("status", "active")
        && request.resource.data.get("blocked", false) == resource.data.get("blocked", false)
        && request.resource.data.get("accessMode", "open-google") == resource.data.get("accessMode", "open-google");
    }

    function validOwnUserUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName",
        "photoURL",
        "lastLoginAt",
        "lastSeenAt",
        "updatedAt"
      ]);
    }

    function noApprovalFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approved",
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "updatedBy",
        "approvalEmailStatus",
        "approvalEmailSentAt",
        "approvalEmailSentBy",
        "approvalEmailPreparedAt",
        "approvalEmailPreparedBy"
      ]);
    }

    function validStagingApprovalToolUpdate(uid) {
      return isApprovedAdminToolUser()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "approved",
          "approvalStatus",
          "approvedAt",
          "approvedBy",
          "updatedAt",
          "updatedBy"
        ])
        && (
          (
            request.resource.data.approved == true
            && request.resource.data.approvalStatus == "approved"
            && request.resource.data.approvedBy == request.auth.uid
          )
          ||
          (
            request.resource.data.approved == false
            && request.resource.data.approvalStatus == "not-approved"
            && request.resource.data.updatedBy == request.auth.uid
          )
        );
    }

    function noStagingApprovalToolFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approved",
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "updatedBy"
      ]);
    }

    function validProgressKeys() {
      return request.resource.data.keys().hasOnly([
        "questionId",
        "lessonId",
        "topic",
        "subTopic",
        "difficulty",
        "viewedAt",
        "answeredAt",
        "selectedOptionId",
        "isCorrect",
        "attemptsCount",
        "lastSeenAt",
        "source"
      ]);
    }

    function noProgressAnswerLeakage() {
      return !request.resource.data.keys().hasAny([
        "correctAnswer",
        "answerKey",
        "solution",
        "fullQuestionPayload"
      ]);
    }

    function validProgressSource() {
      return !request.resource.data.keys().hasAny(["source"])
        || request.resource.data.source in ["quiz", "exam", "practice"];
    }

    function validLearningStateKeys() {
      return request.resource.data.keys().hasOnly([
        "questionId",
        "state",
        "lastReviewedAt",
        "reviewCount",
        "updatedAt",
        "source",
        "schemaVersion",
        "scheduler"
      ]);
    }

    function validLearningStateValue() {
      return request.resource.data.state in ["unknown", "mastered", "review"];
    }

    function validLearningStateSource() {
      return request.resource.data.source == "practice-hub";
    }

    function validLearningStateSchemaVersion() {
      return !request.resource.data.keys().hasAny(["schemaVersion"])
        || request.resource.data.schemaVersion == 2;
    }

    function validSchedulerNumberOrNull(value) {
      return value == null || value is number;
    }

    function validSchedulerNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function validSchedulerTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function validSchedulerObject() {
      return request.resource.data.scheduler is map
        && request.resource.data.scheduler.keys().hasOnly([
          "type",
          "version",
          "stability",
          "difficulty",
          "nextReviewAt",
          "repetitions",
          "lapses",
          "lastRating",
          "scheduledDays",
          "elapsedDays",
          "fsrsState",
          "learningSteps",
          "lastReviewAt"
        ])
        && (request.resource.data.scheduler.type == null || request.resource.data.scheduler.type == "fsrs")
        && (request.resource.data.scheduler.version == null || request.resource.data.scheduler.version is string)
        && validSchedulerNumberOrNull(request.resource.data.scheduler.stability)
        && validSchedulerNumberOrNull(request.resource.data.scheduler.difficulty)
        && validSchedulerTimestampOrNull(request.resource.data.scheduler.nextReviewAt)
        && validSchedulerNonNegativeNumber(request.resource.data.scheduler.repetitions)
        && validSchedulerNonNegativeNumber(request.resource.data.scheduler.lapses)
        && (
          request.resource.data.scheduler.lastRating == null
          || request.resource.data.scheduler.lastRating in ["again", "hard", "good", "easy"]
        )
        && validSchedulerNumberOrNull(request.resource.data.scheduler.scheduledDays)
        && validSchedulerNumberOrNull(request.resource.data.scheduler.elapsedDays)
        && (
          request.resource.data.scheduler.fsrsState == null
          || request.resource.data.scheduler.fsrsState in [0, 1, 2, 3]
        )
        && (
          request.resource.data.scheduler.learningSteps == null
          || validSchedulerNonNegativeNumber(request.resource.data.scheduler.learningSteps)
        )
        && validSchedulerTimestampOrNull(request.resource.data.scheduler.lastReviewAt);
    }

    function validLearningStateScheduler() {
      return !request.resource.data.keys().hasAny(["scheduler"])
        || validSchedulerObject();
    }

    function validSelfUserCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "photoURL",
        "status",
        "blocked",
        "accessMode",
        "createdAt",
        "lastLoginAt",
        "lastSeenAt",
        "updatedAt"
      ]);
    }

    function validMainAdminCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "photoURL",
        "role",
        "status",
        "blocked",
        "accessMode",
        "createdAt",
        "lastLoginAt",
        "lastSeenAt",
        "updatedAt"
      ]);
    }

    function validSelfUserCreateDefaults() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && request.resource.data.blocked == false
        && request.resource.data.accessMode == "open-google";
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == "osherper@gmail.com"
            && validMainAdminCreateKeys()
            && request.resource.data.role == "admin"
            && request.resource.data.status == "approved"
            && request.resource.data.blocked == false)
          ||
          (request.auth.token.email != "osherper@gmail.com"
            && validSelfUserCreateKeys()
            && validSelfUserCreateDefaults())
        );

      allow update: if validStagingApprovalToolUpdate(uid)
        || (
          isAdmin()
          && noStagingApprovalToolFieldChanges()
        )
        || (
          isOwner(uid)
          && resource.data.get("status", "active") != "blocked"
          && resource.data.get("blocked", false) != true
          && validOwnImmutableFields()
          && validOwnUserUpdateKeys()
          && noApprovalFieldChanges()
        );

      allow delete: if false;

      match /progress/{progressId} {
        allow read: if isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.questionId == progressId
          && validProgressKeys()
          && noProgressAnswerLeakage()
          && validProgressSource();
        allow delete: if isAdmin();
      }

      match /learningState/{questionId} {
        allow read: if isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.questionId == questionId
          && validLearningStateKeys()
          && validLearningStateValue()
          && validLearningStateSource()
          && validLearningStateSchemaVersion()
          && validLearningStateScheduler()
          && noProgressAnswerLeakage();
        allow delete: if false;
      }

      match /examAttempts/{attemptId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.attemptId == attemptId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /stats/{statsId} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && statsId == "summary"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "userId",
            "totalQuestionsAnswered",
            "totalCorrect",
            "totalWrong",
            "lessonsCompleted",
            "examsCompleted",
            "gameXP",
            "updatedAt"
          ]);
        allow delete: if false;
      }
    }

    match /siteVersions/{versionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /examQuestionPools/{lessonId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isApproved();
        allow create, update, delete: if isAdmin();
      }
    }

    match /protectedQuestionPreviews/{questionId} {
      allow read: if (isAdmin()
          || (
          signedIn()
          && hasUserDoc(request.auth.uid)
            && userDoc(request.auth.uid).data.get("blocked", false) != true
            && userDoc(request.auth.uid).data.get("status", "active") != "blocked"
          ))
        && !resource.data.keys().hasAny([
          "correctAnswer",
          "correctAnswerId",
          "correctIndex",
          "answerKey",
          "solution",
          "isCorrect",
          "explanation",
          "pointsByAnswer",
          "scoring"
        ]);
      allow create, update, delete: if false;
    }

    match /telegramCourseSchedules/{courseId} {
      allow read, create, update, delete: if isAdmin();

      match /lessons/{lessonId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /userProgress/{uid} {
      allow read: if isAdmin() || isApprovedSelf(uid);
      allow create, update: if isApprovedSelf(uid)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;

      match /{document=**} {
        allow read: if isAdmin() || isApprovedSelf(uid);
        allow create, update: if isApprovedSelf(uid)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /feedbackReports/{reportId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.priority == "normal"
        && request.resource.data.adminNotes == ""
        && request.resource.data.keys().hasOnly([
          "reportId",
          "type",
          "title",
          "description",
          "pageUrl",
          "userId",
          "userName",
          "userEmail",
          "status",
          "priority",
          "adminNotes",
          "createdAt",
          "updatedAt"
        ]);

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /questionReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isApprovedRequester()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "reportId",
          "questionId",
          "lessonId",
          "issueType",
          "freeText",
          "questionText",
          "correctAnswer",
          "selectedAnswer",
          "userId",
          "userEmail",
          "createdAt"
        ]);
      allow update, delete: if false;
    }

    match /questionRatings/{ratingId} {
      allow read: if isAdmin() || (isApprovedRequester() && resource.data.userId == request.auth.uid);
      allow create, update: if isApprovedRequester()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "ratingId",
          "questionId",
          "lessonId",
          "rating",
          "userId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if false;
    }

    match /questionFeedback/{questionId} {
      allow read: if isAdmin() || isApprovedRequester();
      allow create, update: if isApprovedRequester()
        && request.resource.data.questionId == questionId
        && request.resource.data.keys().hasOnly([
          "questionId",
          "lessonId",
          "lastIssueType",
          "lastReportedAt",
          "lastLowRating",
          "status",
          "updatedAt"
        ])
        && request.resource.data.status == "needs-review";
      allow delete: if isAdmin();
    }

    match /questionIssues/{questionId} {
      allow read: if isAdmin() || isApprovedRequester();
      allow create, update: if isApprovedRequester()
        && request.resource.data.questionId == questionId
        && request.resource.data.keys().hasOnly([
          "questionId",
          "lessonId",
          "reportsCount",
          "ratingCount",
          "ratingSum",
          "avgRating",
          "lastReportedAt",
          "status",
          "priority",
          "updatedAt",
          "fixedAt"
        ])
        && request.resource.data.status in ["open", "in-progress"]
        && request.resource.data.priority in ["high", "medium", "low"];
      allow update, delete: if isAdmin();
    }

    match /activeSessions/{uid} {
      allow read: if isAdmin();
      allow create, update: if isApprovedSelf(uid)
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "lastSeenAt",
          "currentPath",
          "userAgent",
          "isMobile"
        ]);
      allow delete: if isAdmin();
    }

    match /gameProgress/{uid} {
      allow read: if isAdmin() || isApprovedSelf(uid);
      allow create, update: if isApprovedSelf(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "userId",
          "totalXp",
          "completedStages",
          "currentUnit",
          "currentStage",
          "difficulty",
          "lastDifficultyRecommendation",
          "mistakes",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
